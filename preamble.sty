\makeatletter
\newcounter{theorem}[section]
\renewcommand{\thetheorem}{\thesection.\arabic{theorem}}

\newcommand{\CreateTheoremEnv}[2]{%
    \NewDocumentEnvironment{#1}{ o }{%
        \refstepcounter{theorem}%
        \par\addvspace{\smallskipamount}\noindent%
        {\scshape #2~\thetheorem\IfNoValueF{##1}{~(##1)}.}~\ignorespaces
    }{\par\addvspace{\smallskipamount}}
}
\makeatother

\CreateTheoremEnv{theorem}{Теорема}
\CreateTheoremEnv{lemma}{Лемма}
\CreateTheoremEnv{proposition}{Предложение}
\CreateTheoremEnv{definition}{Определение}
\CreateTheoremEnv{example}{Пример}
\CreateTheoremEnv{corollary}{Следствие}
\CreateTheoremEnv{exercise}{Упражнение}

\newcommand\qedsymbol{\ensuremath{\blacksquare}}

\newenvironment{proof}[1][Доказательство]{%
    \par
    \addvspace{\smallskipamount}%
    \noindent
    {\scshape #1.}\ %
    \ignorespaces
}{%
    \hfill\qedsymbol
    \par
    \addvspace{\smallskipamount}%
}

